# Required URL-safe 32-byte application key. It derives the AES-256-GCM session
# key and protects other short-lived authenticated application tokens.
# Generate with Python's standard library:
# python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SAFEBOX_COOKIE_KEY=

# Safebox Web application settings.
SAFEBOX_SESSION_TTL_HOURS=720

# Bitcoin backend used for targeted Silent Payment txid detection and explicit
# sweeps. The fee rate is fixed by the operator and displayed before broadcast.
SAFEBOX_BITCOIN_API_BASE=https://blockstream.info/api
SAFEBOX_BITCOIN_LOOKUP_TIMEOUT_SECONDS=10
SAFEBOX_BITCOIN_SWEEP_FEE_RATE=2.0
SAFEBOX_WALLET_LOAD_TIMEOUT_SECONDS=20
# Keep wallet navigation responsive while finalization or relay writes run.
SAFEBOX_WALLET_HOME_SNAPSHOT_TIMEOUT_SECONDS=3
# Bound the single encrypted catalog read used by Manage Records.
SAFEBOX_RECORD_CATALOG_TIMEOUT_SECONDS=3
SAFEBOX_PAYMENT_TIMEOUT_SECONDS=90
SAFEBOX_DEFAULT_BOOTSTRAP_RELAY=wss://relay.getsafebox.app
# Public relays queried for OpenETR origin and control events.
SAFEBOX_OPENETR_RELAYS=wss://relay.openetr.org
SAFEBOX_OPENETR_QUERY_TIMEOUT_SECONDS=5
SAFEBOX_OPENETR_QUERY_LIMIT=100
# Exact comma-delimited ws:// relay URLs permitted for server-side use.
# Each entry must include an explicit port. Leave empty to permit no ws:// relays.
SAFEBOX_ALLOWED_WS_RELAYS=
SAFEBOX_DEFAULT_HOME_MINT=https://mint.getsafebox.app
SAFEBOX_BLOSSOM_HOME_SERVER=https://blossom.getsafebox.app
# Plaintext upload limit. Acorn encrypts bytes before the Blossom upload.
SAFEBOX_MAX_BLOB_BYTES=10485760

# Public LNURL-pay limits and the maximum time a callback waits for the
# standalone worker to place an invoice in the durable queue.
SAFEBOX_PROVIDER_INVOICE_WAIT_SECONDS=10
SAFEBOX_LNURL_MIN_SENDABLE_MSAT=1000
SAFEBOX_LNURL_MAX_SENDABLE_MSAT=100000000
SAFEBOX_LNURL_COMMENT_ALLOWED=256

# Public NIP-05 handle directory. The default stores data/database.db and is
# persisted by the safebox-web-data Docker volume.
SAFEBOX_DATABASE_URL=sqlite:///data/database.db
# Advertise Clear token receive support for claimed NIP-05 handles. When true,
# /.well-known/nostr.json announces NIP-59 delivery with inner kind 7379.
# Leave mint/unit filters empty to accept all Clear tokens after unwrap.
SAFEBOX_CLEAR_RECEIVE_ENABLED=false
SAFEBOX_CLEAR_MINTS=
SAFEBOX_CLEAR_UNITS=

# Informational fiat estimates. The singleton worker refreshes the shared
# last-known-good cache; web workers only read it. A failed refresh never
# blocks wallet access or replaces valid cached values.
SAFEBOX_CURRENCY_RATES_ENABLED=true
SAFEBOX_CURRENCY_RATE_SOURCE_URL=https://blockchain.info/ticker
SAFEBOX_CURRENCY_RATE_INTERVAL_SECONDS=3600
SAFEBOX_CURRENCY_RATE_CURRENCIES=CAD,USD,EUR,GBP,JPY,INR
SAFEBOX_DEFAULT_DISPLAY_CURRENCY=USD
SAFEBOX_CURRENCY_RATE_STALE_SECONDS=86400

# The web tier may use multiple workers because it does not own the provider
# Acorn. SQLite remains appropriate for development; use PostgreSQL before
# relying on concurrent provider-payment job claiming in production.
SAFEBOX_WEB_WORKERS=1
# Per web process. Cash finalization and Clear acceptance run here so slow
# relay or mint calls cannot block Uvicorn's request event loop.
SAFEBOX_BACKGROUND_JOB_THREADS=2

# Standalone provider Acorn worker. The normal Compose deployment starts both
# the web tier and this singleton worker. Review the gateway limitations in
# README.md and use only small test amounts until the release gates are closed.
# For an intentional web-only run, target only the web service:
# docker compose up -d safebox-web
SAFEBOX_SERVICE_ACORN_ENABLED=true
# One-shot migration guard. When true, startup replaces the persisted service
# Acorn only if its relay or mint differs from the configured values below.
# Migration is abandoned while the old wallet holds funds, and the worker
# continues with that persisted wallet. Return this to false after verifying the
# new service npub, relay, and mint.
SAFEBOX_SERVICE_ACORN_MIGRATE=false
SAFEBOX_SERVICE_ACORN_HOME_RELAY=wss://relay.getsafebox.app
SAFEBOX_SERVICE_ACORN_HOME_MINT=https://mint.getsafebox.app
SAFEBOX_SERVICE_ACORN_STATE_FILE=data/service-acorn.json
SAFEBOX_SERVICE_ACORN_POLL_SECONDS=0.5
# Add a NIP-40 expiration tag to service-delivered gift wraps. If this variable
# is absent, the worker defaults to seven days (604800 seconds). Allowed
# non-zero range: 3600 (one hour) to 2592000 (30 days). Set it explicitly to 0
# to omit the tag. Relays decide whether and when to delete the event.
SAFEBOX_SERVICE_ACORN_GIFT_WRAP_RETENTION_SECONDS=604800
# Compatibility mode is the default because many Cashu mint backends do not
# create BOLT11 description-hash invoices for the exact kind-9734 JSON. Set
# this to true only when the configured mint/backend supports that strict
# NIP-57 binding. In compatibility mode payment works, but strict clients may
# reject the resulting unbound kind-9735 receipt.
SAFEBOX_NIP57_REQUIRE_DESCRIPTION_HASH=false
# NIP-05, npub, or hex public key that receives the remaining service balance
# during the explicit `python -m app.service_acorn_worker retire` operation.
SAFEBOX_SERVICE_ACORN_SHUTDOWN_RECIPIENT=
# Optional relay override for the retirement ecash sweep.
SAFEBOX_SERVICE_ACORN_SHUTDOWN_RELAY=

# Defense in depth. Proof maintenance is an explicit operator action and must
# not be triggered by a web deposit or token receipt.
RECEIVE_PROOF_MAINTENANCE_ENABLED=false

# Docker Compose host binding. Keep this on loopback when a reverse proxy runs
# on the host. Do not expose port 8000 directly to the internet.
SAFEBOX_BIND_ADDRESS=127.0.0.1
SAFEBOX_PORT=8000

# Immediate proxy addresses trusted to supply forwarded headers. The default
# permits only a proxy in the same container. When using a host or sibling
# reverse proxy, replace this with that proxy's exact address or narrowly
# scoped container-network range. Never use * on an internet-facing service.
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional local image name used by Docker Compose.
SAFEBOX_IMAGE=safebox-web:local
